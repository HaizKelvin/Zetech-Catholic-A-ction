{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user profile information and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "description": "URL to profile picture." },
        "bio": { "type": "string", "description": "A short spiritual bio." },
        "isSubscribed": { "type": "boolean", "description": "Whether the user wants to receive automatic email updates." },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "SacredMaterial": {
      "title": "Sacred Material",
      "description": "Shared materials for choir, rosary, or liturgy.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["Choir", "Rosary", "Liturgy", "Other"] },
        "description": { "type": "string" },
        "link": { "type": "string" },
        "addedBy": { "type": "string" },
        "contentSnippet": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "addedBy"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Spiritual guidance chat.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "text", "timestamp"]
    },
    "PrayerPetition": {
      "title": "Prayer Petition",
      "description": "A prayer request submitted by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "text", "isPublic", "timestamp"]
    },
    "Event": {
      "title": "Event",
      "description": "Catholic Action upcoming event.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment record for dues or contributions.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "purpose": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "purpose", "status", "timestamp"]
    },
    "Trivia": {
      "title": "Trivia",
      "description": "Religious trivia question.",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correctAnswer": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["question", "options", "correctAnswer"]
    },
    "DailyControl": {
      "title": "Daily Control",
      "description": "Global settings for daily verse and saint.",
      "type": "object",
      "properties": {
        "verse": { "type": "string" },
        "reference": { "type": "string" },
        "saintName": { "type": "string" },
        "saintInfo": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["verse", "reference", "updatedAt"]
    },
    "BoothQr": {
      "title": "Booth QR",
      "description": "Custom uploaded registration portal QR code accessible to any member.",
      "type": "object",
      "properties": {
        "qrCode": { "type": "string", "description": "Base64 string data or URL containing the custom QR code image." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["qrCode", "updatedAt"]
    },
    "CommunityMessage": {
      "title": "Community Message",
      "description": "Messages sent in the community chat.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "senderId", "timestamp"]
    },
    "MembershipRegistration": {
      "title": "Membership Registration",
      "description": "Records for individuals who want to join Catholic Action.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "admissionNumber": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "schoolEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "admissionNumber", "phoneNumber", "schoolEmail", "createdAt"]
    },
    "AppNotification": {
      "title": "Notification",
      "description": "Real-time notifications for users.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The user this notification is for (or 'all' for global)." },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["event", "message", "announcement"] },
        "isRead": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "isRead", "timestamp"]
    },
    "ScheduleItem": {
      "title": "Schedule Item",
      "description": "Community semester plans and activity schedules.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "type": { "type": "string", "enum": ["Mass", "Meeting", "Social", "Other"] },
        "downloadUrl": { "type": "string" },
        "addedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "type", "addedBy", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Users." },
    "/sacred_materials/{id}": { "schema": "SacredMaterial", "description": "Shared church materials." },
    "/users/{userId}/chatHistory/{messageId}": { "schema": "ChatMessage", "description": "Chat." },
    "/petitions/{id}": { "schema": "PrayerPetition", "description": "Prayer requests." },
    "/events/{id}": { "schema": "Event", "description": "Events." },
    "/payments/{id}": { "schema": "Payment", "description": "Payments." },
    "/trivia/{id}": { "schema": "Trivia", "description": "Trivia Questions." },
    "/control/daily_bread": { "schema": "DailyControl", "description": "Daily content." },
    "/control/booth_qr": { "schema": "BoothQr", "description": "Global custom registration QR code accessible to any member." },
    "/community_chat/{id}": { "schema": "CommunityMessage", "description": "Main community messages." },
    "/registrations/{id}": { "schema": "MembershipRegistration", "description": "Registration entries for new members." },
    "/notifications/{id}": { "schema": "AppNotification", "description": "Real-time alerts and notices." },
    "/schedule/{id}": { "schema": "ScheduleItem", "description": "Semester schedules and activities." }
  }
}
